{
  "description": "PR57 A17B light: 8 decoder layers, 32 experts/top-10, 8 vision layers, MTP1. Random initialization; single-node 4-GPU TP1/PP2/EP2/CP1 comparison.",
  "nproc_per_node": 4,
  "env": {
    "CUDA_DEVICE_MAX_CONNECTIONS": "1",
    "NVTE_FUSED_ATTN": "1",
    "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
    "HF_HUB_OFFLINE": "1",
    "QWEN35_VL_GRID_CACHE": "1",
    "OMP_NUM_THREADS": "4"
  },
  "args": {
    "tokenizer_type": "NullTokenizer",
    "vocab_size": 248320,
    "make_vocab_size_divisible_by": 485,
    "model_arch": "qwen35_vl",
    "model_variant": "397b_a17b_light",
    "image_token_id": 248056,
    "num_layers": 8,
    "hidden_size": 4096,
    "ffn_hidden_size": 10240,
    "num_attention_heads": 32,
    "kv_channels": 256,
    "max_position_embeddings": 262144,
    "group_query_attention": true,
    "num_query_groups": 2,
    "qk_layernorm": true,
    "attention_output_gate": true,
    "experimental_attention_variant": "gated_delta_net",
    "linear_attention_freq": 4,
    "linear_conv_kernel_dim": 4,
    "linear_key_head_dim": 128,
    "linear_value_head_dim": 128,
    "linear_num_key_heads": 16,
    "linear_num_value_heads": 64,
    "normalization": "RMSNorm",
    "apply_layernorm_1p": true,
    "norm_epsilon": "1e-6",
    "swiglu": true,
    "disable_bias_linear": true,
    "untie_embeddings_and_output_weights": true,
    "position_embedding_type": "rope",
    "rotary_percent": 0.25,
    "rotary_base": 10000000,
    "rotary_seq_len_interpolation_factor": 1,
    "attention_dropout": 0.0,
    "hidden_dropout": 0.0,
    "num_experts": 32,
    "moe_ffn_hidden_size": 1024,
    "moe_shared_expert_intermediate_size": 1024,
    "moe_shared_expert_gate": true,
    "moe_router_load_balancing_type": "aux_loss",
    "moe_router_topk": 10,
    "moe_grouped_gemm": true,
    "moe_aux_loss_coeff": "1e-3",
    "moe_token_dispatcher_type": "alltoall",
    "moe_router_dtype": "fp32",
    "moe_permute_fusion": true,
    "moe_router_fusion": true,
    "vision_num_layers": 8,
    "mtp_num_layers": 1,
    "mtp_loss_scaling_factor": 0.1,
    "sft": true,
    "tensor_model_parallel_size": 1,
    "pipeline_model_parallel_size": 2,
    "expert_model_parallel_size": 2,
    "context_parallel_size": 1,
    "use_distributed_optimizer": true,
    "micro_batch_size": 1,
    "global_batch_size": 8,
    "train_iters": 500,
    "seq_length": 32768,
    "seed": 1234,
    "lr": 0.0001,
    "min_lr": 1e-05,
    "lr_decay_style": "cosine",
    "lr_decay_iters": 500,
    "lr_warmup_iters": 20,
    "weight_decay": 0.1,
    "clip_grad": 1.0,
    "adam_beta1": 0.9,
    "adam_beta2": 0.95,
    "bf16": true,
    "no_gradient_accumulation_fusion": true,
    "tensorboard_log_interval": 1,
    "log_memory_to_tensorboard": true,
    "use_mcore_models": true,
    "transformer_impl": "transformer_engine",
    "calculate_per_token_loss": true,
    "enable_experimental": true,
    "use_flash_attn": true,
    "cross_entropy_loss_fusion": true,
    "cross_entropy_fusion_impl": "te",
    "mdp_enable": true,
    "mdp_encoder_max_payload_rows": 8192,
    "encoder_recompute_granularity": "whole",
    "mdp_greedy_packing": true,
    "thd_static_packing": true,
    "pad_packed_seq_alignment": "max",
    "max_seqlen_per_dp_cp_rank": 32768,
    "thd_max_packed_sequences": 64,
    "log_interval": 1,
    "log_params_norm": true,
    "log_num_zeros_in_grad": true,
    "eval_interval": 100,
    "eval_iters": 5,
    "distributed_timeout_minutes": 10,
    "expert_tensor_parallel_size": 1,
    "recompute_granularity": "full",
    "recompute_method": "uniform",
    "recompute_num_layers": 1,
    "dataloader_type": "cyclic",
    "use_vanilla_collate_fn": true,
    "use_packed_sequence": true,
    "num_workers": 4
  }
}
